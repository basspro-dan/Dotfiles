# NOTE: These will be listed alphabetically when issuing the 'alias' Command.

# General Env
alias ip='ip -c -h -s'
alias ifconfig='ip a'
alias cls='clear'
alias ccls='cd;clear'
alias ls='ls --color'
alias ll='ls -l'
alias path='echo $PATH'

# Python Virtual Env 
alias ackack='source ~/.venv/bin/activate'
alias dack='deactivate'

# Vagrant
alias vd='vagrant destroy -f'
alias vu='vagrant up'

# Git
alias gss='cls ; git status'
alias gaa='git add . -A ; gss'
# because the dafault git branch can be litterally anything: 
alias gcm='git checkout $( git symbolic-ref refs/remotes/origin/HEAD | cut -d / -f4 ) ;  gfa'
alias gca='gcm; gfa'
alias gfa='git fetch --all && git pull'
alias gsh='git stash ; gss'
alias gsp='git stash pop'
alias gcp='gaa ; git commit ; gpob'

# Docker
alias dps='docker ps -a'
alias dsac='docker stop $(docker ps -a -q)'
alias drmac='docker rm $(docker ps -a -q)'
alias dd='docker rmi $(docker image list -q)'
alias dnuke='dsac; drmac; dd'
alias 1='1st.sh'
alias ghh='export GITHUB_TOKEN="" ; gh auth login'
alias gpob='git push origin $GitB'

# Kubernetes
alias kk='kubectl' 

# Terraform
alias tf='terraform'

# Ansible
alias anping='ansible -i ~/ans-inventory.txt -m ping all | awk '\''/UNREACHABLE/ {print $1; found=1} END {if (!found) print "\033[32mAll servers accessible\033[0m"}'\'''


# AWS
alias awz='. ~/Authz/awscreds.sh $1'

# Azure
alias azl='az login --use-device-code'
