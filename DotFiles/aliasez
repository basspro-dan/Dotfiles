# NOTE: These will be listed alphabetically when issuing the 'alias' Command.

# General Env
alias ip='ip -c -h -s'
alias ifconfig='ip a'
alias cls='clear'
alias ccls='cd;clear'
alias ls='ls --color'
alias ll='ls -l'
alias path='echo $PATH'

# Python Virtual Env 
alias ackack='source ~/.venv/bin/activate'
alias dack='deactivate'

# Vagrant
alias vd='vagrant destroy -f'
alias vu='vagrant up'

# Git
alias gss='git status'
alias gaa='git add . -A ; gss'
alias gcm='git checkout $( git symbolic-ref refs/remotes/origin/HEAD | cut -d / -f4 )'
alias gfa='git fetch --all && git pull'
alias gsh='git stash'
alias gsp='git stash pop'

# Docker
alias dps='docker ps -a'
alias dsac='docker stop $(docker ps -a -q)'
alias drmac='docker rm $(docker ps -a -q)'
alias dd='docker rmi $(docker image list -q)'
alias dnuke='dsac; drmac; dd'
alias 1='1st.sh'
alias ghh='export GITHUB_TOKEN="" ; gh auth login'
alias gpob='git push origin $GitB'

# Kubernetes
alias kk='kubectl' 

# Terraform
alias tf='terraform'

# Ansible
alias anping='ansible -i ~/basspro_inventory.yml all -m ping'

# AWS
alias awz='. ~/Authz/awscreds.sh $1'
